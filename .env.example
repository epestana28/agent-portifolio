# Copy to .env and fill in. scripts/quickstart.sh creates one with random values.
AP_SQL_PASSWORD=
AP_DEV_SIGNING_KEY=
AP_TENANT_ID=
# Optional: object id used for the simulated executor identity.
# AP_EXECUTOR_OBJECT_ID=0e0e0e0e-0000-4000-8000-000000000001
# Optional: image to run (default is the published one; `docker compose build` builds locally).
# AP_IMAGE=ghcr.io/epestana28/agent-portifolio:latest
