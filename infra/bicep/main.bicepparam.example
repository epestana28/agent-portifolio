// Example parameters file. Copy to main.bicepparam and fill in.
// The real file does not go into the repository (add it to .gitignore).
//
// All the values below are placeholders. None is a real value, none is a secret.
// The parameters with no default value in main.bicep must be decided and filled in here.
// The values marked TO VALIDATE are not confirmed in the research of 2026-11-11.

using './main.bicep'

// ---------- General ----------
param namePrefix = 'apdemo'                                  // lowercase and digits, maximum 9
param tenantId = '00000000-0000-0000-0000-000000000000'     // TO FILL IN FOR THE TENANT
param adminObjectIds = [
  '00000000-0000-0000-0000-000000000000'                    // TO FILL IN FOR THE TENANT: Entra group that administers SQL
]
param sqlAdminLogin = 'ADMIN-GROUP-NAME'                      // TO FILL IN FOR THE TENANT
param sqlAdminPrincipalType = 'Group'

// ---------- Applications ----------
param containerImage = 'REGISTRY/IMAGE:TAG'                  // TO FILL IN: single image with the three services (AP_SERVICE selects which one runs). The one in docker-compose.yml is ghcr.io/epestana28/agent-portifolio
param registryServer = ''                                   // empty if the image does not require an identity to be pulled
param targetPort = 8080                                     // must match the image port
param controlApiAudience = 'api://TO-FILL-IN-CONTROL'        // TO FILL IN FOR THE TENANT
param executorAudience = 'api://TO-FILL-IN-EXECUTOR'       // TO FILL IN FOR THE TENANT
param adaptersMode = 'Simulation'                            // only value the code accepts. Any other prevents startup. There is no real adapter

// ---------- Database and digests ----------
param databaseSkuName = 'GP_Gen5_2'                         // TO VALIDATE: it only appears as a service objective in a T-SQL example
param isLedgerOn = false                                    // IRREVERSIBLE. Decide in Phase A (see README)
param backupStorageRedundancy = 'Geo'
param storageSkuName = 'Standard_GRS'                       // LRS is not supported for automatic digests
param digestImmutabilityDays = 1                            // FOR TESTING ONLY. The documentation warns that 1 day is not suitable for production
param enableLedgerDigestUpload = false                      // turn on only after the write role of the SQL server on the account (README)

// ---------- Service Bus, monitoring ----------
param serviceBusSkuName = 'Standard'                        // TO VALIDATE: exact spelling in the reference
param logRetentionInDays = 30                               // TO VALIDATE: accepted values "per pricing plan"
param logDailyQuotaGb = 0                                   // 0 sets no limit

// ---------- APIM ----------
param apimSkuName = 'Developer'                             // cost and network decision for Phase A
param apimSkuCapacity = 1                                   // for Consumption it must be 0
param apimPublisherEmail = 'publisher@example.invalid'       // TO FILL IN
param apimPublisherName = 'TO FILL IN'
param executorClientApplicationIds = [
  '00000000-0000-0000-0000-000000000000'                    // TO FILL IN FOR THE TENANT: appId of the agent identity
]

param tags = {
  project: 'agent-portifolio'
  environment: 'test'
}
